    <script type="module">
        import { initializeApp } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-app.js";
        import { getAuth, signInAnonymously, signInWithCustomToken, onAuthStateChanged } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-auth.js";
        import { getFirestore, doc, getDoc, setDoc, onSnapshot } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-firestore.js";

        /***********************************************************************
         * 1. GLOBAL BIOMES OF THE ARK OF BABYLON (9 SECTORS: 0 + I..VIII)
         ***********************************************************************/
        const ARK_BIOMES = {
// ... existing code ... -->
            // Visibility of each sector (0 = Center CIEL, 1..8 = Sectors I..VIII)
            unlockedSectors: {
                0: true,
                1: true,
                2: true,
                3: true,
                4: true,
                5: true,
                6: true,
                7: true,
                8: true
            },
            // Admin security state: ALWAYS starts in Player Mode (isAdmin: false) with password "ентропія"
            admin: {
                isAdmin: false,
                pin: 'ентропія'
            },
            // Detailed Sector Mode (null = whole island, 0..8 = focused sector)
            focusedSectorId: null,
            details: {
                markers: JSON.parse(JSON.stringify(USER_BASE_MARKERS)),
                ruinClusters: USER_SAVED_RUIN_SEEDS.map(reconstructSavedRuinCluster)
            },
            view: {
                panX: 0,
                panY: 0,
                zoom: 1.0,
                isDragging: false,
                dragStartX: 0,
                dragStartY: 0,
                hasMoved: false,
                cursorWorldX: 0,
                cursorWorldY: 0
            },
            editor: {
                activeTab: 'island', // 'island' | 'markers' | 'sectors'
                activeTool: 'pan',   // 'pan' | 'marker'
                selectedItem: null   // { type: 'marker' | 'ruin', id }
            }
        };

        /***********************************************************************
         * 4.1 FIREBASE REAL-TIME CLOUD SYNC (ACROSS ALL DEVICES)
         ***********************************************************************/
        const appId = typeof __app_id !== 'undefined' ? __app_id : 'entropy-ark-317-map';
        let db = null;
        let auth = null;
        let currentUser = null;
        let isApplyingRemoteUpdate = false;

        function setCloudBadgeStatus(statusText, colorClass = 'bg-emerald-400') {
            const dot = document.getElementById('cloud-sync-dot');
            const txt = document.getElementById('cloud-sync-text');
            if (dot) dot.className = `w-1.5 h-1.5 rounded-full ${colorClass}`;
            if (txt) txt.textContent = statusText;
        }

        async function initCloudSync() {
            try {
                if (typeof __firebase_config === 'undefined' || !__firebase_config) {
                    setCloudBadgeStatus('Локальна сесія', 'bg-slate-400');
                    return;
                }
                const firebaseConfig = JSON.parse(__firebase_config);
                const app = initializeApp(firebaseConfig);
                db = getFirestore(app);
                auth = getAuth(app);

                // RULE 3: Authenticate FIRST before any Firestore operation
                if (typeof __initial_auth_token !== 'undefined' && __initial_auth_token) {
                    await signInWithCustomToken(auth, __initial_auth_token);
                } else {
                    await signInAnonymously(auth);
                }

                onAuthStateChanged(auth, (user) => {
                    currentUser = user;
                    if (user) {
                        const uidEl = document.getElementById('session-uid-display');
                        if (uidEl) uidEl.textContent = `ID: ${user.uid}`;
                        subscribeToGlobalMapState();
                    }
                });
            } catch (err) {
                console.error('Cloud init error:', err);
                setCloudBadgeStatus('Помилка мережі', 'bg-rose-400');
            }
        }

        function subscribeToGlobalMapState() {
            if (!currentUser || !db) return;

            // RULE 1: Strict public path so all devices (Admin & Players) see the same map state
            const stateDocRef = doc(db, 'artifacts', appId, 'public', 'data', 'arkMapState', 'globalState');

            onSnapshot(
                stateDocRef,
                (snapshot) => {
                    setCloudBadgeStatus('Синхронізовано', 'bg-emerald-400');
                    if (snapshot.exists()) {
                        const data = snapshot.data();
                        applyRemoteMapData(data);
                    } else {
                        // First time initialization in cloud
                        saveStateToLocal();
                    }
                },
                (error) => {
                    console.error('Snapshot listener error:', error);
                    setCloudBadgeStatus('Збій синхр.', 'bg-rose-400');
                }
            );
        }

        function applyRemoteMapData(parsed) {
            if (!parsed) return;
            isApplyingRemoteUpdate = true;

            const prevBiome = state.terrain.useBiomeDesign;

            if (parsed.unlockedSectors) {
                let unlockedObj = parsed.unlockedSectors;
                if (typeof unlockedObj === 'string') {
                    try { unlockedObj = JSON.parse(unlockedObj); } catch (e) {}
                }
                for (let i = 0; i <= 8; i++) {
                    if (typeof unlockedObj[i] === 'boolean') {
                        state.unlockedSectors[i] = unlockedObj[i];
                    }
                }
            }

            if (parsed.markers) {
                let markersArr = parsed.markers;
                if (typeof markersArr === 'string') {
                    try { markersArr = JSON.parse(markersArr); } catch (e) {}
                }
                if (Array.isArray(markersArr)) {
                    state.details.markers = markersArr;
                }
            }

            if (typeof parsed.useBiomeDesign === 'boolean') {
                state.terrain.useBiomeDesign = parsed.useBiomeDesign;
            }
            if (typeof parsed.showSectors === 'boolean') {
                state.overlays.showSectors = parsed.showSectors;
                state.overlays.showBarrier = parsed.showSectors;
            }
            if (typeof parsed.showLabels === 'boolean') {
                state.ruinConfig.showLabels = parsed.showLabels;
            }
            if (typeof parsed.adminPin === 'string' && parsed.adminPin.trim() !== '') {
                state.admin.pin = parsed.adminPin.trim();
            }

            // Refresh or clear currently inspected item if it was modified or hidden
            if (state.editor.selectedItem) {
                const sel = state.editor.selectedItem;
                if (sel.type === 'marker') {
                    const m = state.details.markers.find(item => item.id === sel.id);
                    if (!m || !state.unlockedSectors[getSectorIdAtPoint(m.x, m.y)]) {
                        deselectItem();
                    } else {
                        selectItem('marker', m.id);
                    }
                } else if (sel.type === 'ruin') {
                    const r = state.details.ruinClusters.find(item => item.id === sel.id);
                    if (!r || !state.unlockedSectors[getSectorIdAtPoint(r.x, r.y)]) {
                        deselectItem();
                    }
                }
            }

            if (state.focusedSectorId !== null) {
                renderSectorDossier(state.focusedSectorId);
            }

            syncUIFromState();
            if (prevBiome !== state.terrain.useBiomeDesign) {
                rebuildIslandTerrain();
            } else {
                renderMap();
            }

            isApplyingRemoteUpdate = false;
        }

        /***********************************************************************
         * 5. SECTOR GEOMETRY & BIOME COLOR BLENDING ENGINE
         ***********************************************************************/
// ... existing code ... -->
        function closeAdminLoginModal() {
            document.getElementById('admin-login-modal').classList.add('hidden');
        }

        function verifyAdminLogin() {
            const entered = document.getElementById('admin-login-pin').value.trim();
            if (entered.toLowerCase() === state.admin.pin.toLowerCase()) {
                closeAdminLoginModal();
                setAdminMode(true);
                showToast('Вітаємо, Майстре! Консоль Адміна розблоковано');
            } else {
                showToast('Невірний пароль доступу');
            }
        }

        function updateAdminPin() {
            const newPin = document.getElementById('admin-pin-input').value.trim();
            if (newPin) {
                state.admin.pin = newPin;
                saveStateToLocal();
                showToast('Пароль Адміна оновлено та синхронізовано');
            }
        }

        function setAdminMode(isAdmin) {
            state.admin.isAdmin = isAdmin;
            const sidebar = document.getElementById('main-sidebar');
            const toggleBtn = document.getElementById('sidebar-toggle-btn');
            const jsonBtn = document.getElementById('admin-json-btn');
            const roleBadge = document.getElementById('role-status-badge');
            const lockIcon = document.getElementById('admin-lock-icon');
            const lockText = document.getElementById('admin-lock-text');

            if (isAdmin) {
                sidebar.classList.remove('hidden');
                toggleBtn.classList.remove('hidden');
                jsonBtn.classList.remove('hidden');
                roleBadge.textContent = '👑 Режим Адміна';
                roleBadge.className = 'px-2 py-0.5 text-[10px] font-mono-tech font-semibold uppercase tracking-wider bg-amber-500/20 text-amber-300 border border-amber-500/40 rounded';
                lockIcon.textContent = '🔓';
                lockText.textContent = 'Вийти з Адміна';
                if (state.editor.selectedItem?.type === 'marker') {
                    selectItem('marker', state.editor.selectedItem.id);
                }
            } else {
                setEditorTool('pan');
                sidebar.classList.add('hidden');
                toggleBtn.classList.add('hidden');
                jsonBtn.classList.add('hidden');
                roleBadge.textContent = '👁️ Режим Гравця';
                roleBadge.className = 'px-2 py-0.5 text-[10px] font-mono-tech font-semibold uppercase tracking-wider bg-slate-800 text-slate-300 border border-slate-700 rounded';
                lockIcon.textContent = '🔒';
                lockText.textContent = 'Вхід Адміна';
                document.getElementById('edit-marker-box').classList.add('hidden');
                if (state.editor.selectedItem) {
                    document.getElementById('sel-admin-actions').classList.add('hidden');
                }
            }

            setTimeout(resizeCanvas, 50);
        }

        function syncUIFromState() {
// ... existing code ... -->
        canvas.addEventListener('touchend', (e) => {
            if (state.view.isDragging && !state.view.hasMoved && e.changedTouches.length === 1) {
                const t = e.changedTouches[0];
                const rect = canvas.getBoundingClientRect();
                const world = screenToWorld(t.clientX - rect.left, t.clientY - rect.top);
                handleMapClickAction(world.x, world.y);
            }
            state.view.isDragging = false;
            lastTouchDist = null;
        });

        async function saveStateToLocal() {
            if (isApplyingRemoteUpdate) return;
            if (!currentUser || !db) return;

            try {
                setCloudBadgeStatus('Збереження...', 'bg-amber-400 animate-ping');
                const stateDocRef = doc(db, 'artifacts', appId, 'public', 'data', 'arkMapState', 'globalState');
                const payload = {
                    unlockedSectors: JSON.stringify(state.unlockedSectors),
                    markers: JSON.stringify(state.details.markers),
                    useBiomeDesign: state.terrain.useBiomeDesign,
                    showSectors: state.overlays.showSectors,
                    showLabels: state.ruinConfig.showLabels,
                    adminPin: state.admin.pin,
                    updatedAt: Date.now(),
                    updatedBy: currentUser.uid
                };
                await setDoc(stateDocRef, payload);
                setCloudBadgeStatus('Синхронізовано', 'bg-emerald-400');
            } catch (err) {
                console.error('Cloud save error:', err);
