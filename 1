        /***********************************************************************
         * 5. SECTOR GEOMETRY & BIOME COLOR BLENDING ENGINE
         ***********************************************************************/
        function getSectorIdAtPoint(nx, ny) {
            const dist = Math.hypot(nx, ny);
            if (dist <= 0.25) return 0; // Sector 0: Complex CIEL
            let angle = Math.atan2(ny, nx); // -PI..PI
            // Sector I is at the top (-PI/2), each sector spans PI/4 (45 deg)
            let shifted = angle + Math.PI / 2 + Math.PI / 8;
            while (shifted < 0) shifted += Math.PI * 2;
            while (shifted >= Math.PI * 2) shifted -= Math.PI * 2;
            const sectorIndex = Math.floor(shifted / (Math.PI / 4)) + 1;
            return Math.min(8, Math.max(1, sectorIndex));
        }

        function getSectorAngles(sectorId) {
            if (sectorId === 0) return { startAngle: 0, endAngle: Math.PI * 2, midAngle: 0 };
            const idx = sectorId - 1;
            const midAngle = -Math.PI / 2 + idx * (Math.PI / 4);
            return {
                startAngle: midAngle - Math.PI / 8,
                endAngle: midAngle + Math.PI / 8,
                midAngle
            };
        }

        function getSectorWorldCenter(sectorId) {
            if (sectorId === 0) return { x: 0, y: 0 };
            const { midAngle } = getSectorAngles(sectorId);
            return {
                x: Math.cos(midAngle) * 0.50,
                y: Math.sin(midAngle) * 0.50
            };
        }

        function getBlendedBiomePalette(nx, ny) {
            const dist = Math.hypot(nx, ny);
            const p0 = ARK_BIOMES[0].palette;

            let angle = Math.atan2(ny, nx) + Math.PI / 2;
            while (angle < 0) angle += Math.PI * 2;
            while (angle >= Math.PI * 2) angle -= Math.PI * 2;

            const exactSector = angle / (Math.PI / 4);
            const idxA = (Math.floor(exactSector) % 8) + 1;
            const idxB = ((Math.floor(exactSector) + 1) % 8) + 1;
            const frac = exactSector - Math.floor(exactSector);

            const smoothAngular = frac < 0.35 ? 0 : (frac > 0.65 ? 1 : (frac - 0.35) / 0.30);
            const pA = ARK_BIOMES[idxA].palette;
            const pB = ARK_BIOMES[idxB].palette;

            const outerPalette = {
                low:  pA.low.map((v, i) => v + (pB.low[i] - v) * smoothAngular),
                mid:  pA.mid.map((v, i) => v + (pB.mid[i] - v) * smoothAngular),
                high: pA.high.map((v, i) => v + (pB.high[i] - v) * smoothAngular),
                peak: pA.peak.map((v, i) => v + (pB.peak[i] - v) * smoothAngular)
            };

            if (dist < 0.21) return p0;
            if (dist < 0.29) {
                const t = (dist - 0.21) / 0.08;
                return {
                    low:  p0.low.map((v, i) => v + (outerPalette.low[i] - v) * t),
                    mid:  p0.mid.map((v, i) => v + (outerPalette.mid[i] - v) * t),
                    high: p0.high.map((v, i) => v + (outerPalette.high[i] - v) * t),
                    peak: p0.peak.map((v, i) => v + (outerPalette.peak[i] - v) * t)
                };
            }
            return outerPalette;
        }

