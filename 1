        /***********************************************************************
         * 3. DETERMINISTIC PRNG & SIMPLEX NOISE ENGINE
         ***********************************************************************/
        function mulberry32(a) {
            return function() {
                let t = a += 0x6D2B79F5;
                t = Math.imul(t ^ t >>> 15, t | 1);
                t ^= t + Math.imul(t ^ t >>> 7, t | 61);
                return ((t ^ t >>> 14) >>> 0) / 4294967296;
            };
        }

        class FastNoise2D {
            constructor(seed = 317) {
                this.p = new Uint8Array(512);
                const rng = mulberry32(seed);
                const perm = new Uint8Array(256);
                for (let i = 0; i < 256; i++) perm[i] = i;
                for (let i = 255; i > 0; i--) {
                    const j = Math.floor(rng() * (i + 1));
                    const swap = perm[i];
                    perm[i] = perm[j];
                    perm[j] = swap;
                }
                for (let i = 0; i < 512; i++) this.p[i] = perm[i & 255];
            }

            fade(t) { return t * t * t * (t * (t * 6 - 15) + 10); }
            lerp(t, a, b) { return a + t * (b - a); }
            grad(hash, x, y) {
                const h = hash & 7;
                const u = h < 4 ? x : y;
                const v = h < 4 ? y : x;
                return ((h & 1) !== 0 ? -u : u) + ((h & 2) !== 0 ? -2.0 * v : 2.0 * v);
            }

            noise(x, y) {
                const X = Math.floor(x) & 255;
                const Y = Math.floor(y) & 255;
                x -= Math.floor(x);
                y -= Math.floor(y);
                const u = this.fade(x);
                const v = this.fade(y);
                const A = this.p[X] + Y, B = this.p[X + 1] + Y;
                const res = this.lerp(v,
                    this.lerp(u, this.grad(this.p[A], x, y), this.grad(this.p[B], x - 1, y)),
                    this.lerp(u, this.grad(this.p[A + 1], x, y - 1), this.grad(this.p[B + 1], x - 1, y - 1))
                );
                return (res + 1) * 0.5;
            }

            fbm(x, y, octaves = 5, persistence = 0.52, lacunarity = 2.05) {
                let total = 0;
                let frequency = 1;
                let amplitude = 1;
                let maxValue = 0;
                for (let i = 0; i < octaves; i++) {
                    total += this.noise(x * frequency, y * frequency) * amplitude;
                    maxValue += amplitude;
                    amplitude *= persistence;
                    frequency *= lacunarity;
                }
                return total / maxValue;
            }
        }

        function reconstructSavedRuinCluster(meta) {
            const rng = mulberry32(meta.seed);
            const destr = 0.64;
            const bCount = meta.buildingCount || 8;
            const buildings = [];

            for (let b = 0; b < bCount; b++) {
                const angle = (b / bCount) * Math.PI * 2 + (rng() - 0.5) * 0.55;
                const dist = b === 0 ? rng() * 0.18 : (0.28 + rng() * 0.56);
                const bx = Math.cos(angle) * dist;
                const by = Math.sin(angle) * dist;
                const bw = 0.22 + rng() * 0.26;
                const bh = 0.18 + rng() * 0.24;
                const brot = Math.floor(rng() * 4) * (Math.PI / 2) + (rng() - 0.5) * 0.08;

                let shape = 'rect';
                if (meta.type === 'lab_dome' && rng() > 0.35) shape = 'octagon_dome';
                else if (meta.type === 'industrial' && rng() > 0.45) shape = 'silo_circle';
                else if (rng() > 0.5) shape = 'l_shape';

                const wallSegments = [];
                const segCount = 8;
                for (let s = 0; s < segCount; s++) {
                    wallSegments.push(rng() > destr * 0.55);
                }
                if (!wallSegments.some(Boolean)) wallSegments[0] = true;

                const roofIntactRatio = Math.max(0.08, 1 - destr * (0.65 + rng() * 0.45));
                const hasInnerRooms = bw > 0.26 && bh > 0.20 && rng() > 0.25;

                buildings.push({
                    shape, x: bx, y: by, w: bw, h: bh, rot: brot,
                    wallSegments, roofIntactRatio, hasInnerRooms,
                    collapseCorner: Math.floor(rng() * 4)
                });
            }

            const craters = [];
            const craterCount = Math.floor(1 + destr * 3.5);
            for (let c = 0; c < craterCount; c++) {
                const ca = rng() * Math.PI * 2;
                const cd = rng() * 0.65;
                craters.push({
                    x: Math.cos(ca) * cd,
                    y: Math.sin(ca) * cd,
                    r: 0.10 + rng() * 0.14
                });
            }

            const rubbleChunks = [];
            const rubbleCount = Math.floor(18 + destr * 32);
            for (let r = 0; r < rubbleCount; r++) {
                const refB = buildings[r % buildings.length];
                const rx = refB.x + (rng() - 0.5) * 0.45;
                const ry = refB.y + (rng() - 0.5) * 0.45;
                rubbleChunks.push({
                    x: rx, y: ry,
                    w: 0.03 + rng() * 0.055,
                    h: 0.025 + rng() * 0.045,
                    rot: rng() * Math.PI,
                    dark: rng() > 0.5
                });
            }

            const roads = [
                { x1: -0.85, y1: 0, x2: 0.85, y2: 0, width: 0.12 }
            ];
            if (rng() > 0.3) {
                roads.push({ x1: 0, y1: -0.75, x2: 0, y2: 0.75, width: 0.10 });
            }

            return {
                ...meta,
                buildings,
                craters,
                rubbleChunks,
                roads
            };
        }

