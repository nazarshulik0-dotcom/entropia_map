        function selectItem(type, id) {
            state.editor.selectedItem = { type, id };
            const card = document.getElementById('selected-item-card');
            const badgeEl = document.getElementById('sel-item-badge');
            const titleEl = document.getElementById('sel-item-title');
            const descEl = document.getElementById('sel-item-desc');
            const coordsEl = document.getElementById('sel-item-coords');
            const adminActions = document.getElementById('sel-admin-actions');
            const editBox = document.getElementById('edit-marker-box');

            if (type === 'marker') {
                const m = state.details.markers.find(item => item.id === id);
                if (!m) return;
                const st = MARKER_STYLES[m.category] || MARKER_STYLES.note;
                const secId = getSectorIdAtPoint(m.x, m.y);

                badgeEl.textContent = `${st.symbol} ${st.badge} • ${ARK_BIOMES[secId].code}`;
                titleEl.textContent = m.title;
                descEl.textContent = m.notes || 'Опис відсутній.';
                const kmX = (m.x * (state.overlays.arkDiameterKm / 2)).toFixed(1);
                const kmY = (-m.y * (state.overlays.arkDiameterKm / 2)).toFixed(1);
                coordsEl.textContent = `X: ${kmX} км, Y: ${kmY} км`;

                card.classList.remove('hidden');
                adminActions.classList.toggle('hidden', !state.admin.isAdmin);

                if (state.admin.isAdmin) {
                    editBox.classList.remove('hidden');
                    document.getElementById('edit-marker-category').value = m.category;
                    document.getElementById('edit-marker-title').value = m.title;
                    document.getElementById('edit-marker-notes').value = m.notes || '';
                }
            } else if (type === 'ruin') {
                const r = state.details.ruinClusters.find(item => item.id === id);
                if (!r) return;
                const secId = getSectorIdAtPoint(r.x, r.y);

                badgeEl.textContent = `🏛️ ${r.badge} • ${ARK_BIOMES[secId].code}`;
                titleEl.textContent = r.title;
                descEl.textContent = r.notes;
                const kmX = (r.x * (state.overlays.arkDiameterKm / 2)).toFixed(1);
                const kmY = (-r.y * (state.overlays.arkDiameterKm / 2)).toFixed(1);
                coordsEl.textContent = `X: ${kmX} км, Y: ${kmY} км`;

                card.classList.remove('hidden');
                adminActions.classList.add('hidden');
                if (editBox) editBox.classList.add('hidden');
            }

            renderMarkersList();
            renderMap();
        }

