        async function fetchGithubRemoteMapState() {
            if (!githubSyncConfig.repo) return false;
            try {
                const apiUrl = `https://api.github.com/repos/${githubSyncConfig.repo}/contents/map-state.json?t=${Date.now()}`;
                const res = await fetch(apiUrl, {
                    headers: { 'Accept': 'application/vnd.github.v3+json' },
                    cache: 'no-store'
                });
                if (res.ok) {
                    const fileData = await res.json();
                    githubSyncConfig.lastSha = fileData.sha;
                    const decoded = new TextDecoder().decode(
                        Uint8Array.from(atob(fileData.content.replace(/\s/g, '')), c => c.charCodeAt(0))
                    );
                    const parsed = JSON.parse(decoded);
                    applyRemoteMapData(parsed);
                    setCloudBadgeStatus('GitHub Синхр.', 'bg-emerald-400');
                    return true;
                }
            } catch (e) {
                // Silent if map-state.json does not exist yet
            }
            return false;
        }

        async function pushStateToGithubRepo() {
            if (!githubSyncConfig.repo || !githubSyncConfig.token) return false;
            try {
                setCloudBadgeStatus('Збереження GitHub...', 'bg-amber-400 animate-ping');
                const payload = buildExportableMapPayload();
                const jsonStr = JSON.stringify(payload, null, 2);
                const bytes = new TextEncoder().encode(jsonStr);
                let binary = '';
                bytes.forEach(b => binary += String.fromCharCode(b));
                const base64Content = btoa(binary);

                const apiUrl = `https://api.github.com/repos/${githubSyncConfig.repo}/contents/map-state.json`;
                if (!githubSyncConfig.lastSha) {
                    const checkRes = await fetch(apiUrl, {
                        headers: {
                            'Accept': 'application/vnd.github.v3+json',
                            'Authorization': `Bearer ${githubSyncConfig.token}`
                        },
                        cache: 'no-store'
                    });
                    if (checkRes.ok) {
                        const existing = await checkRes.json();
                        githubSyncConfig.lastSha = existing.sha;
                    }
                }

                const bodyObj = {
                    message: 'Оновлення стану інтерактивної карти ЕНТРОПІЯ',
                    content: base64Content
                };
                if (githubSyncConfig.lastSha) {
                    bodyObj.sha = githubSyncConfig.lastSha;
                }

                const putRes = await fetch(apiUrl, {
                    method: 'PUT',
                    headers: {
                        'Accept': 'application/vnd.github.v3+json',
                        'Authorization': `Bearer ${githubSyncConfig.token}`,
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify(bodyObj)
                });

                if (putRes.ok) {
                    const putData = await putRes.json();
                    githubSyncConfig.lastSha = putData.content?.sha || null;
                    setCloudBadgeStatus('GitHub Синхр.', 'bg-emerald-400');
                    return true;
                } else {
                    setCloudBadgeStatus('Помилка токена', 'bg-rose-400');
                }
            } catch (err) {
                console.error('GitHub push error:', err);
                setCloudBadgeStatus('Збій GitHub', 'bg-rose-400');
            }
            return false;
        }

