        /***********************************************************************
         * 9. CANVAS INTERACTION (PAN, ZOOM, CLICK MARKER / RUIN)
         ***********************************************************************/
        canvas.addEventListener('mousedown', (e) => {
            const rect = canvas.getBoundingClientRect();
            const sx = e.clientX - rect.left;
            const sy = e.clientY - rect.top;

            state.view.isDragging = true;
            state.view.hasMoved = false;
            state.view.dragStartX = sx - state.view.panX;
            state.view.dragStartY = sy - state.view.panY;
            canvas.style.cursor = 'grabbing';
        });

        window.addEventListener('mousemove', (e) => {
            const rect = canvas.getBoundingClientRect();
            const sx = e.clientX - rect.left;
            const sy = e.clientY - rect.top;
            const worldPt = screenToWorld(sx, sy);

            state.view.cursorWorldX = worldPt.x;
            state.view.cursorWorldY = worldPt.y;

            const halfKm = state.overlays.arkDiameterKm / 2;
            const kmX = (worldPt.x * halfKm).toFixed(1);
            const kmY = (-worldPt.y * halfKm).toFixed(1);
            const hudCoords = document.getElementById('hud-coords');
            if (hudCoords) hudCoords.textContent = `X: ${kmX >= 0 ? '+' : ''}${kmX} км | Y: ${kmY >= 0 ? '+' : ''}${kmY} км`;

            const secId = getSectorIdAtPoint(worldPt.x, worldPt.y);
            const hudBiome = document.getElementById('hud-sector-biome');
            if (hudBiome) {
                hudBiome.textContent = state.unlockedSectors[secId]
                    ? `${ARK_BIOMES[secId].code}: ${ARK_BIOMES[secId].name}`
                    : `${ARK_BIOMES[secId].code}: 🔒 Сектор не досліджено`;
            }

            if (state.view.isDragging) {
                const dx = sx - state.view.dragStartX - state.view.panX;
                const dy = sy - state.view.dragStartY - state.view.panY;
                if (Math.hypot(dx, dy) > 4) state.view.hasMoved = true;

                state.view.panX = sx - state.view.dragStartX;
                state.view.panY = sy - state.view.dragStartY;
                renderMap();
            }
        });

        window.addEventListener('mouseup', (e) => {
            if (!state.view.isDragging) return;
            state.view.isDragging = false;
            canvas.style.cursor = state.editor.activeTool === 'marker' ? 'crosshair' : 'grab';

            if (!state.view.hasMoved && e.target === canvas) {
                const rect = canvas.getBoundingClientRect();
                handleCanvasClick(e.clientX - rect.left, e.clientY - rect.top);
            }
        });

        function handleCanvasClick(sx, sy) {
            const worldPt = screenToWorld(sx, sy);
            const { baseSize } = getMapDrawMetrics();

            if (state.admin.isAdmin && state.editor.activeTool === 'marker') {
                const cat = document.getElementById('new-marker-category').value;
                const titleInput = document.getElementById('new-marker-title');
                const notesInput = document.getElementById('new-marker-notes');
                const st = MARKER_STYLES[cat];

                const newMarker = {
                    id: 'm_' + Date.now() + '_' + Math.floor(Math.random() * 1000),
                    x: worldPt.x,
                    y: worldPt.y,
                    category: cat,
                    title: titleInput.value.trim() || st.badge,
                    notes: notesInput.value.trim() || ''
                };

                state.details.markers.push(newMarker);
                titleInput.value = '';
                notesInput.value = '';

                setEditorTool('pan');
                selectItem('marker', newMarker.id);
                saveStateToLocal();
                showToast('Нову мітку додано на карту');
                return;
            }

            for (let i = state.details.markers.length - 1; i >= 0; i--) {
                const m = state.details.markers[i];
                const secId = getSectorIdAtPoint(m.x, m.y);
                if (!state.unlockedSectors[secId]) continue;

                const pt = worldToScreen(m.x, m.y);
                if (Math.hypot(sx - pt.x, sy - pt.y) <= 16) {
                    selectItem('marker', m.id);
                    return;
                }
            }

            for (let i = state.details.ruinClusters.length - 1; i >= 0; i--) {
                const r = state.details.ruinClusters[i];
                const secId = getSectorIdAtPoint(r.x, r.y);
                if (!state.unlockedSectors[secId]) continue;

                const pt = worldToScreen(r.x, r.y);
                const radPx = r.radiusWorld * (r.scaleMultiplier || 1) * (baseSize / 2);
                if (Math.hypot(sx - pt.x, sy - pt.y) <= Math.max(14, radPx)) {
                    selectItem('ruin', r.id);
                    return;
                }
            }

            deselectItem();
        }

        canvas.addEventListener('wheel', (e) => {
            e.preventDefault();
            const factor = e.deltaY < 0 ? 1.14 : 0.88;
            zoomMap(factor, e.clientX, e.clientY);
        }, { passive: false });

        function zoomMap(factor, clientX = null, clientY = null) {
            const oldZoom = state.view.zoom;
            const newZoom = Math.max(0.55, Math.min(7.0, oldZoom * factor));
            if (newZoom === oldZoom) return;

            if (clientX !== null && clientY !== null) {
                const rect = canvas.getBoundingClientRect();
                const sx = clientX - rect.left - canvas.width / 2;
                const sy = clientY - rect.top - canvas.height / 2;
                const scaleChange = newZoom / oldZoom;
                state.view.panX = sx - (sx - state.view.panX) * scaleChange;
                state.view.panY = sy - (sy - state.view.panY) * scaleChange;
            }

            state.view.zoom = newZoom;
            document.getElementById('hud-zoom').textContent = `${Math.round(newZoom * 100)}%`;
            renderMap();
        }

        function resetViewport() {
            state.view.panX = 0;
            state.view.panY = 0;
            state.view.zoom = 1.0;
            document.getElementById('hud-zoom').textContent = '100%';
            renderMap();
        }

        let lastTouchDist = null;
        canvas.addEventListener('touchstart', (e) => {
            if (e.touches.length === 1) {
                const t = e.touches[0];
                const rect = canvas.getBoundingClientRect();
                state.view.isDragging = true;
                state.view.hasMoved = false;
                state.view.dragStartX = (t.clientX - rect.left) - state.view.panX;
                state.view.dragStartY = (t.clientY - rect.top) - state.view.panY;
            } else if (e.touches.length === 2) {
                state.view.isDragging = false;
                lastTouchDist = Math.hypot(
                    e.touches[0].clientX - e.touches[1].clientX,
                    e.touches[0].clientY - e.touches[1].clientY
                );
            }
        }, { passive: true });

        canvas.addEventListener('touchmove', (e) => {
            if (e.touches.length === 1 && state.view.isDragging) {
                const t = e.touches[0];
                const rect = canvas.getBoundingClientRect();
                const sx = t.clientX - rect.left;
                const sy = t.clientY - rect.top;
                state.view.hasMoved = true;
                state.view.panX = sx - state.view.dragStartX;
                state.view.panY = sy - state.view.dragStartY;
                renderMap();
            } else if (e.touches.length === 2 && lastTouchDist) {
                const dist = Math.hypot(
                    e.touches[0].clientX - e.touches[1].clientX,
                    e.touches[0].clientY - e.touches[1].clientY
                );
                zoomMap(dist / lastTouchDist);
                lastTouchDist = dist;
            }
        }, { passive: true });

        canvas.addEventListener('touchend', () => {
            state.view.isDragging = false;
            lastTouchDist = null;
        });

        async function connectGithubLiveSync() {
            const repoVal = document.getElementById('github-repo-input').value.trim();
            const tokenVal = document.getElementById('github-token-input').value.trim();
            if (repoVal) githubSyncConfig.repo = repoVal;
            if (tokenVal) {
                githubSyncConfig.token = tokenVal;
                try { localStorage.setItem('entropy_gh_token', tokenVal); } catch (e) {}
            }

            if (!githubSyncConfig.token) {
                showToast('Введіть GitHub Personal Access Token для авто-запису');
                return;
            }

            const ok = await pushStateToGithubRepo();
            if (ok) {
                showToast('Стан карти успішно синхронізовано з GitHub репозиторієм!');
            } else {
                showToast('Не вдалося записати в GitHub. Перевірте права токена (repo)');
            }
        }

        function downloadUpdatedIndexHtml() {
            try {
                const embeddedEl = document.getElementById('embedded-map-state');
                if (embeddedEl) {
                    embeddedEl.textContent = '\n' + JSON.stringify(buildExportableMapPayload(), null, 2) + '\n';
                }

                const clone = document.documentElement.cloneNode(true);
                const idsToHide = [
                    'main-sidebar', 'sidebar-toggle-btn', 'admin-json-btn',
                    'admin-download-html-btn', 'admin-login-modal', 'json-modal',
                    'selected-item-card', 'edit-marker-box', 'create-marker-box', 'sector-focus-banner'
                ];
                idsToHide.forEach(id => {
                    const el = clone.querySelector(`#${id}`);
                    if (el) el.classList.add('hidden');
                });
                const roleBadge = clone.querySelector('#role-status-badge');
                if (roleBadge) {
                    roleBadge.textContent = '👁️ Режим Гравця';
                    roleBadge.className = 'px-2 py-0.5 text-[10px] font-mono-tech font-semibold uppercase tracking-wider bg-slate-800 text-slate-300 border border-slate-700 rounded';
                }
                const lockIcon = clone.querySelector('#admin-lock-icon');
                if (lockIcon) lockIcon.textContent = '🔒';
                const lockText = clone.querySelector('#admin-lock-text');
                if (lockText) lockText.textContent = 'Вхід Адміна';

                const htmlContent = '<!DOCTYPE html>\n' + clone.outerHTML;
                const blob = new Blob([htmlContent], { type: 'text/html;charset=utf-8' });
                const link = document.createElement('a');
                link.download = 'index.html';
                link.href = URL.createObjectURL(blob);
                link.click();
                URL.revokeObjectURL(link.href);
                showToast('Оновлений index.html завантажено! Замініть ним файл на GitHub.');
            } catch (err) {
                console.error('Download HTML error:', err);
                showToast('Помилка під час формування HTML');
            }
        }

        function openJsonModal() {
            const exportObj = buildExportableMapPayload();
            document.getElementById('json-textarea').value = JSON.stringify(exportObj, null, 2);
            const repoInput = document.getElementById('github-repo-input');
            if (repoInput) repoInput.value = githubSyncConfig.repo;
            document.getElementById('json-modal').classList.remove('hidden');
        }

        function closeJsonModal() {
            document.getElementById('json-modal').classList.add('hidden');
        }

        function copyJsonToClipboard() {
            const textarea = document.getElementById('json-textarea');
            textarea.select();
            document.execCommand('copy');
            showToast('JSON-код карти скопійовано');
        }

        function importJsonFromModal() {
            try {
                const raw = document.getElementById('json-textarea').value;
                const parsed = JSON.parse(raw);
                applyRemoteMapData(parsed);
                closeJsonModal();
                saveStateToLocal();
                showToast('Карту успішно оновлено з JSON');
            } catch (e) {
                showToast('Помилка читання JSON');
            }
        }

        function exportMapPNG() {
            renderMap();
            const link = document.createElement('a');
            link.download = `entropy-ark-317-map.png`;
            link.href = canvas.toDataURL('image/png');
            link.click();
            showToast('Зображення PNG збережено');
        }

        function toggleSidebar() {
            if (!state.admin.isAdmin) return;
            const sb = document.getElementById('main-sidebar');
            sb.classList.toggle('hidden');
            setTimeout(resizeCanvas, 50);
        }

        function showToast(msg) {
            const box = document.getElementById('toast-box');
            document.getElementById('toast-text').textContent = msg;
            box.classList.remove('opacity-0');
            box.classList.add('opacity-100');
            clearTimeout(window.__toastTimer);
            window.__toastTimer = setTimeout(() => {
                box.classList.remove('opacity-100');
                box.classList.add('opacity-0');
            }, 2400);
        }

        function syncUIFromState() {
            document.getElementById('toggle-biome-colors').checked = state.terrain.useBiomeDesign;
            document.getElementById('toggle-sector-borders').checked = state.overlays.showSectors;
            document.getElementById('toggle-ruin-titles').checked = state.ruinConfig.showLabels;
            document.getElementById('admin-pin-input').value = state.admin.pin;
            renderIslandSectorsList();
            renderMarkersList();
            renderDetailedSectorCards();
        }

        function resizeCanvas() {
            const wrapper = document.getElementById('canvas-wrapper');
            if (!wrapper) return;
            canvas.width = wrapper.clientWidth || window.innerWidth;
            canvas.height = wrapper.clientHeight || (window.innerHeight - 52);
            renderMap();
        }

        window.addEventListener('resize', resizeCanvas);

        function bootMapApp() {
            if (window.__entropyMapBooted) return;
            window.__entropyMapBooted = true;
            loadInitialState();
            setAdminMode(false);
            switchSidebarTab('island');
            setEditorTool('pan');
            syncUIFromState();
            resizeCanvas();
            rebuildIslandTerrain();
            initCloudSync();
        }

        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', bootMapApp);
        } else {
            bootMapApp();
        }
    </script>
</body>
</html>
