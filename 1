        function focusDetailedSector(sectorId) {
            state.focusedSectorId = sectorId;
            if (!state.unlockedSectors[sectorId]) {
                state.unlockedSectors[sectorId] = true;
                renderIslandSectorsList();
            }

            const w = canvas.width;
            const h = canvas.height;
            const targetZoom = sectorId === 0 ? 2.6 : 2.15;
            state.view.zoom = targetZoom;

            const baseSize = Math.min(w, h) * 0.86 * state.view.zoom;
            const centerWorld = getSectorWorldCenter(sectorId);
            state.view.panX = -centerWorld.x * (baseSize / 2);
            state.view.panY = -centerWorld.y * (baseSize / 2);

            const b = ARK_BIOMES[sectorId];
            document.getElementById('header-focus-sector').textContent = `Огляд: ${b.code} (${b.name})`;
            document.getElementById('hud-zoom').textContent = `${Math.round(state.view.zoom * 100)}%`;

            const banner = document.getElementById('sector-focus-banner');
            banner.classList.remove('hidden');
            document.getElementById('focus-banner-title').textContent = `${b.code}: ${b.name}`;

            renderDetailedSectorCards();
            renderSectorDossier(sectorId);
            renderMap();
        }

