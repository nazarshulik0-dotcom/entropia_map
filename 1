<!DOCTYPE html>
<html lang="uk" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ЕНТРОПІЯ — Інтерактивна Карта Ковчега Вавилонії</title>
    <!-- Вбудований стан карти (автоматично оновлюється при скачуванні оновленого index.html) -->
    <script id="embedded-map-state" type="application/json">
{
  "unlockedSectors": {
    "0": true,
    "1": true,
    "2": true,
    "3": true,
    "4": true,
    "5": true,
    "6": true,
    "7": true,
    "8": true
  },
  "useBiomeDesign": true,
  "showSectors": true,
  "showLabels": true,
  "adminPin": "ентропія",
  "githubRepo": "nazarshulik0-dotcom/entropia_map",
  "markers": null
}
    </script>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500;600;700&family=Orbitron:wght@500;700;800&display=swap" rel="stylesheet">
    <style>
        :root {
            --bg-dark: #060911;
            --panel-bg: rgba(10, 15, 26, 0.94);
            --accent-cyan: #22d3ee;
            --accent-amber: #f59e0b;
            --accent-crimson: #f43f5e;
        }

        * {
            box-sizing: border-box;
            user-select: none;
            -webkit-user-select: none;
        }

        body {
            margin: 0;
            padding: 0;
            background-color: var(--bg-dark);
            color: #e2e8f0;
            font-family: 'Inter', sans-serif;
            overflow: hidden;
            width: 100vw;
            height: 100vh;
        }

        .font-mono-tech {
            font-family: 'JetBrains Mono', monospace;
        }

        .font-display {
            font-family: 'Orbitron', sans-serif;
        }

        ::-webkit-scrollbar {
            width: 5px;
            height: 5px;
        }
        ::-webkit-scrollbar-track {
            background: rgba(15, 23, 42, 0.6);
        }
        ::-webkit-scrollbar-thumb {
            background: rgba(56, 189, 248, 0.3);
            border-radius: 9999px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: rgba(56, 189, 248, 0.6);
        }

        .glass-panel {
            background: rgba(10, 16, 28, 0.90);
            backdrop-filter: blur(14px);
            -webkit-backdrop-filter: blur(14px);
            border: 1px solid rgba(56, 189, 248, 0.18);
        }

        .tool-btn-active {
            background: rgba(34, 211, 238, 0.18) !important;
            border-color: #22d3ee !important;
            color: #67e8f9 !important;
            box-shadow: 0 0 14px rgba(34, 211, 238, 0.25);
        }

        canvas {
            display: block;
            width: 100%;
            height: 100%;
            touch-action: none;
        }
    </style>
</head>
<body class="relative flex flex-col w-screen h-screen overflow-hidden select-none">

    <!-- TOP HEADER BAR -->
    <header class="glass-panel z-30 flex items-center justify-between px-3 py-2 border-b border-cyan-500/20 shrink-0">
        <!-- Brand & Project Title -->
        <div class="flex items-center gap-3">
            <div class="relative flex items-center justify-center w-9 h-9 rounded-lg bg-cyan-950/80 border border-cyan-400/40 shadow-[0_0_15px_rgba(34,211,238,0.2)]">
                <svg class="w-5 h-5 text-cyan-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                    <polygon points="7.86 2 16.14 2 22 7.86 22 16.14 16.14 22 7.86 22 2 16.14 2 7.86 7.86 2"></polygon>
                    <circle cx="12" cy="12" r="3"></circle>
                    <line x1="12" y1="2" x2="12" y2="9"></line>
                    <line x1="12" y1="15" x2="12" y2="22"></line>
                    <line x1="2" y1="12" x2="9" y2="12"></line>
                    <line x1="15" y1="12" x2="22" y2="12"></line>
                </svg>
                <span class="absolute -top-0.5 -right-0.5 w-2 h-2 bg-cyan-400 rounded-full animate-ping"></span>
            </div>
            <div>
                <div class="flex items-center gap-2">
                    <h1 class="font-display text-sm sm:text-base font-bold tracking-wider text-white uppercase">ЕНТРОПІЯ</h1>
                    <span class="hidden sm:inline-block px-2 py-0.5 text-[10px] font-mono-tech font-semibold uppercase tracking-widest bg-cyan-500/15 text-cyan-300 border border-cyan-500/30 rounded">
                        Ковчег Вавилонії
                    </span>
                    <span id="role-status-badge" class="px-2 py-0.5 text-[10px] font-mono-tech font-semibold uppercase tracking-wider bg-slate-800 text-slate-300 border border-slate-700 rounded">
                        👁️ Режим Гравця
                    </span>
                    <span id="cloud-sync-badge" class="hidden sm:inline-flex items-center gap-1.5 px-2 py-0.5 text-[10px] font-mono-tech bg-emerald-950/70 text-emerald-300 border border-emerald-500/30 rounded" title="Статус синхронізації карти">
                        <span id="cloud-sync-dot" class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
                        <span id="cloud-sync-text">Активно</span>
                    </span>
                </div>
                <p class="text-[11px] text-slate-400 hidden md:block">Глобальна карта 9 біомів Ковчега (#317) • Інтерактивний Атлас</p>
            </div>
        </div>

        <!-- Center Quick Sector View Switcher -->
        <div class="hidden lg:flex items-center gap-2 px-3 py-1 rounded-xl bg-slate-900/90 border border-slate-700/70 text-xs">
            <span class="text-slate-400">Відкрито секторів:</span>
            <span id="header-unlocked-count" class="font-mono-tech font-bold text-cyan-300">9 / 9</span>
            <span class="text-slate-600">|</span>
            <span id="header-focus-sector" class="text-amber-300 font-medium">Огляд: Увесь Ковчег</span>
        </div>

        <!-- Right Actions: Export / Project JSON / Admin Access Lock -->
        <div class="flex items-center gap-1.5 sm:gap-2">
            <button type="button" onclick="exportMapPNG()" title="Завантажити карту як зображення PNG" class="px-2.5 py-1.5 rounded-lg bg-slate-800/80 hover:bg-slate-700/80 border border-slate-600/50 text-xs text-slate-200 flex items-center gap-1.5 transition cursor-pointer">
                <svg class="w-3.5 h-3.5 text-cyan-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                <span class="hidden sm:inline">PNG</span>
            </button>

            <button type="button" onclick="downloadUpdatedIndexHtml()" id="admin-download-html-btn" title="Скачати оновлений index.html з усіма змінами для GitHub Pages" class="hidden px-2.5 py-1.5 rounded-lg bg-emerald-500/20 hover:bg-emerald-500/30 border border-emerald-400/50 text-xs text-emerald-200 font-medium flex items-center gap-1.5 transition cursor-pointer">
                <svg class="w-3.5 h-3.5 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/></svg>
                <span class="hidden sm:inline">Оновити HTML</span>
            </button>

            <button type="button" onclick="openJsonModal()" id="admin-json-btn" title="Синхронізація GitHub / Експорт стану карти (JSON)" class="hidden px-2.5 py-1.5 rounded-lg bg-slate-800/80 hover:bg-slate-700/80 border border-slate-600/50 text-xs text-slate-200 flex items-center gap-1.5 transition cursor-pointer">
                <svg class="w-3.5 h-3.5 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7H5a2 2 0 00-2 2v9a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-3m-1 4l-3 3m0 0l-3-3m3 3V4"/></svg>
                <span class="hidden sm:inline">Синхр. / Код</span>
            </button>

            <button type="button" onclick="toggleSidebar()" id="sidebar-toggle-btn" class="hidden px-2.5 py-1.5 rounded-lg bg-cyan-500/20 hover:bg-cyan-500/30 border border-cyan-400/40 text-xs text-cyan-200 font-medium flex items-center gap-1.5 transition cursor-pointer">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h7"/></svg>
                <span class="hidden md:inline">Панель Адміна</span>
            </button>

            <button type="button" onclick="handleAdminButtonClick()" id="admin-lock-btn" title="Перемкнути режим Гравця / Адміна (Майстра)" class="px-2.5 py-1.5 rounded-lg bg-amber-500/20 hover:bg-amber-500/30 border border-amber-400/50 text-xs text-amber-200 font-medium flex items-center gap-1.5 transition cursor-pointer">
                <span id="admin-lock-icon">🔒</span>
                <span id="admin-lock-text" class="hidden sm:inline">Вхід Адміна</span>
            </button>
        </div>
    </header>

    <!-- MAIN WORKSPACE -->
    <div class="relative flex-1 flex overflow-hidden">

        <!-- LEFT / ADMIN SIDEBAR PANEL (ONLY VISIBLE TO ADMIN) -->
        <aside id="main-sidebar" class="hidden glass-panel z-20 w-80 sm:w-96 h-full flex flex-col border-r border-cyan-500/20 transition-all duration-300 shrink-0">
            
            <!-- Sidebar Navigation Tabs (1. Острів, 2. Мітки, 3. Сектори) -->
            <div class="grid grid-cols-3 gap-1.5 p-2 bg-slate-950/80 border-b border-slate-800 shrink-0">
                <button type="button" onclick="switchSidebarTab('island')" id="tab-btn-island" class="py-2 px-2 rounded-lg text-xs font-semibold flex flex-col items-center gap-1 transition cursor-pointer">
                    <svg class="w-4 h-4 text-cyan-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                    <span>1. Острів</span>
                </button>
                <button type="button" onclick="switchSidebarTab('markers')" id="tab-btn-markers" class="py-2 px-2 rounded-lg text-xs font-semibold flex flex-col items-center gap-1 transition cursor-pointer">
                    <svg class="w-4 h-4 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
                    <span>2. Мітки <span id="markers-count-badge" class="px-1.5 py-0.2 text-[10px] rounded-full bg-amber-500/20 text-amber-300">10</span></span>
                </button>
                <button type="button" onclick="switchSidebarTab('sectors')" id="tab-btn-sectors" class="py-2 px-2 rounded-lg text-xs font-semibold flex flex-col items-center gap-1 transition cursor-pointer">
                    <svg class="w-4 h-4 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7"/></svg>
                    <span>3. Сектори</span>
                </button>
            </div>

            <!-- TAB 1: ОСТРІВ (ПРИХОВУВАННЯ НЕВІДКРИТИХ СЕКТОРІВ + ГЛОБАЛЬНІ БІОМИ) -->
            <div id="tab-content-island" class="flex-1 overflow-y-auto p-4 space-y-4">
                <div class="p-3 rounded-xl bg-cyan-950/40 border border-cyan-500/30 flex items-start gap-2.5">
                    <svg class="w-4 h-4 text-cyan-400 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
                    <div class="text-xs text-slate-300 leading-relaxed">
                        <span class="font-semibold text-cyan-300">Геометрію та руїни зафіксовано:</span> Острів #317, квартали руїн та сітка заблоковані від випадкових змін. Нижче ви керуєте **відкриттям секторів за сюжетом** та **відображенням глобальних біомів**.
                    </div>
                </div>

                <!-- Quick Reveal / Hide All Sectors -->
                <div class="space-y-2">
                    <div class="flex items-center justify-between">
                        <label class="text-xs font-semibold uppercase tracking-wider text-slate-200">Туман війни (Сектори)</label>
                        <div class="flex items-center gap-1.5">
                            <button type="button" onclick="setAllSectorsUnlocked(true)" class="px-2 py-1 rounded bg-emerald-500/20 hover:bg-emerald-500/30 border border-emerald-500/40 text-[11px] text-emerald-300 font-medium transition cursor-pointer">
                                Відкрити всі
                            </button>
                            <button type="button" onclick="setOnlyStartSectorUnlocked()" class="px-2 py-1 rounded bg-amber-500/20 hover:bg-amber-500/30 border border-amber-500/40 text-[11px] text-amber-300 font-medium transition cursor-pointer" title="Залишити відкритим лише Сектор I (Карантинні Сади)">
                                Тільки старт (I)
                            </button>
                            <button type="button" onclick="setAllSectorsUnlocked(false)" class="px-2 py-1 rounded bg-slate-800 hover:bg-slate-700 border border-slate-700 text-[11px] text-slate-300 transition cursor-pointer">
                                Сховати всі
                            </button>
                        </div>
                    </div>
                    <p class="text-[11px] text-slate-400">Якщо сектор схований, він закритий голографічним куполом невідомості (ні рельєф, ні руїни, ні мітки всередині не відображаються гравцям).</p>
                </div>

                <!-- List of 9 Biomes with Visibility Toggles -->
                <div id="island-sectors-list" class="space-y-2"></div>

                <!-- Global Biome Visual Style Controls -->
                <div class="p-3.5 rounded-xl bg-slate-900/75 border border-slate-800 space-y-3">
                    <h3 class="text-xs font-semibold uppercase tracking-wider text-cyan-400">Відображення глобальних біомів</h3>

                    <label class="flex items-center justify-between cursor-pointer text-xs text-slate-200">
                        <span>Дизайн острова під глобальні біоми</span>
                        <input type="checkbox" id="toggle-biome-colors" checked onchange="toggleBiomeDisplayOptions()" class="w-4 h-4 accent-cyan-400 rounded cursor-pointer">
                    </label>

                    <label class="flex items-center justify-between cursor-pointer text-xs text-slate-200">
                        <span>Межі секторів та купол Бар'єра</span>
                        <input type="checkbox" id="toggle-sector-borders" checked onchange="toggleBiomeDisplayOptions()" class="w-4 h-4 accent-cyan-400 rounded cursor-pointer">
                    </label>

                    <label class="flex items-center justify-between cursor-pointer text-xs text-slate-200">
                        <span>Підписи назв руїн при наближенні</span>
                        <input type="checkbox" id="toggle-ruin-titles" checked onchange="toggleBiomeDisplayOptions()" class="w-4 h-4 accent-cyan-400 rounded cursor-pointer">
                    </label>
                </div>
            </div>

            <!-- TAB 2: МІТКИ (ДОДАВАННЯ, РЕДАГУВАННЯ НАЗВИ Й ОПИСУ, ВИДАЛЕННЯ) -->
            <div id="tab-content-markers" class="hidden flex-1 overflow-y-auto p-4 space-y-4">
                
                <!-- Mode Switcher: Select/Edit vs Place New Marker -->
                <div class="grid grid-cols-2 gap-1.5">
                    <button type="button" onclick="setEditorTool('pan')" id="tool-btn-pan" class="p-2.5 rounded-xl bg-slate-900 border border-slate-700 text-xs font-medium flex items-center justify-center gap-2 transition cursor-pointer">
                        <svg class="w-4 h-4 text-cyan-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 15l-2 5L9 9l11 4-5 2zm0 0l5 5"/></svg>
                        <span>Вибір / Редагування</span>
                    </button>
                    <button type="button" onclick="setEditorTool('marker')" id="tool-btn-marker" class="p-2.5 rounded-xl bg-slate-900 border border-slate-700 text-xs font-medium flex items-center justify-center gap-2 transition cursor-pointer">
                        <svg class="w-4 h-4 text-amber-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/></svg>
                        <span>+ Поставити мітку</span>
                    </button>
                </div>

                <!-- EDIT EXISTING MARKER PANEL -->
                <div id="edit-marker-box" class="hidden p-3.5 rounded-xl bg-amber-950/30 border border-amber-400/50 space-y-3 shadow-lg">
                    <div class="flex items-center justify-between border-b border-amber-500/20 pb-2">
                        <div class="flex items-center gap-2">
                            <span class="w-2 h-2 rounded-full bg-amber-400"></span>
                            <h3 class="text-xs font-bold uppercase tracking-wider text-amber-300">Редагування обраної мітки</h3>
                        </div>
                        <button type="button" onclick="deselectItem()" class="text-xs text-slate-400 hover:text-white cursor-pointer">✕</button>
                    </div>

                    <div>
                        <label class="text-[11px] text-slate-300 block mb-1">Категорія іконки:</label>
                        <select id="edit-marker-category" class="w-full px-2.5 py-1.5 rounded-lg bg-slate-950 border border-slate-700 text-xs text-white focus:outline-none focus:border-amber-400">
                            <option value="ciel">💠 СІЕЛЬ / Центральне Ядро</option>
                            <option value="beacon">🗼 Маяк Архангела</option>
                            <option value="metro">🚇 Вагон метро (Точка старту)</option>
                            <option value="ruins">🏛️ Особливий бункер / Руїни</option>
                            <option value="corruption">☣️ Прорив Скверни / Аномалія</option>
                            <option value="camp">⛺ Табір / Поселення</option>
                            <option value="nature">⛰️ Природний орієнтир</option>
                            <option value="note">📍 Нотатка / Подія</option>
                        </select>
                    </div>

                    <div>
                        <label class="text-[11px] text-slate-300 block mb-1">Назва мітки:</label>
                        <input type="text" id="edit-marker-title" class="w-full px-2.5 py-1.5 rounded-lg bg-slate-950 border border-slate-700 text-xs text-white focus:outline-none focus:border-amber-400">
                    </div>

                    <div>
                        <label class="text-[11px] text-slate-300 block mb-1">Опис та нотатки:</label>
                        <textarea id="edit-marker-notes" rows="3" class="w-full px-2.5 py-1.5 rounded-lg bg-slate-950 border border-slate-700 text-xs text-white focus:outline-none focus:border-amber-400"></textarea>
                    </div>

                    <div class="flex items-center justify-between gap-2 pt-1">
                        <button type="button" onclick="saveEditedMarker()" class="flex-1 py-2 px-3 rounded-lg bg-amber-500 hover:bg-amber-400 text-slate-950 font-bold text-xs transition shadow cursor-pointer">
                            💾 Зберегти зміни
                        </button>
                        <button type="button" onclick="deleteSelectedItem()" class="py-2 px-3 rounded-lg bg-rose-500/20 hover:bg-rose-500/35 border border-rose-500/40 text-rose-300 text-xs font-medium transition cursor-pointer">
                            Видалити
                        </button>
                    </div>
                </div>

                <!-- CREATE NEW MARKER CONFIG -->
                <div id="create-marker-box" class="hidden p-3.5 rounded-xl bg-slate-900/90 border border-cyan-500/40 space-y-2.5">
                    <div class="text-xs font-semibold text-cyan-300">Нова мітка на карті</div>
                    <div>
                        <label class="text-[11px] text-slate-400 block mb-1">Тип локації:</label>
                        <select id="new-marker-category" class="w-full px-2.5 py-1.5 rounded-lg bg-slate-950 border border-slate-700 text-xs text-white focus:outline-none focus:border-cyan-400">
                            <option value="note">📍 Нотатка / Інтерес</option>
                            <option value="camp">⛺ Табір / Поселення</option>
                            <option value="ruins">🏛️ Особливий бункер / Руїни</option>
                            <option value="corruption">☣️ Прорив Скверни / Аномалія</option>
                            <option value="nature">⛰️ Природний орієнтир</option>
                            <option value="metro">🚇 Станція / Вагон метро</option>
                            <option value="beacon">🗼 Маяк Архангела</option>
                            <option value="ciel">💠 Вузол СІЕЛЬ</option>
                        </select>
                    </div>
                    <div>
                        <label class="text-[11px] text-slate-400 block mb-1">Назва нової мітки:</label>
                        <input type="text" id="new-marker-title" placeholder="Напр.: Покинутий термінал зв'язку" class="w-full px-2.5 py-1.5 rounded-lg bg-slate-950 border border-slate-700 text-xs text-white focus:outline-none focus:border-cyan-400">
                    </div>
