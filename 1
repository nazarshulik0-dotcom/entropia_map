        function drawMarkers(cx, cy, baseSize) {
            state.details.markers.forEach(m => {
                const secId = getSectorIdAtPoint(m.x, m.y);
                if (!state.unlockedSectors[secId]) return;

                const pt = worldToScreen(m.x, m.y);
                const st = MARKER_STYLES[m.category] || MARKER_STYLES.note;
                const isSel = state.editor.selectedItem?.type === 'marker' && state.editor.selectedItem?.id === m.id;

                ctx.save();
                ctx.beginPath();
                ctx.arc(pt.x, pt.y, isSel ? 19 : 14, 0, Math.PI * 2);
                ctx.fillStyle = st.color + (isSel ? '44' : '22');
                ctx.fill();

                if (isSel) {
                    ctx.strokeStyle = '#ffffff';
                    ctx.lineWidth = 2;
                    ctx.stroke();
                }

                ctx.beginPath();
                ctx.arc(pt.x, pt.y, 10, 0, Math.PI * 2);
                ctx.fillStyle = st.bg;
                ctx.fill();
                ctx.lineWidth = 2;
                ctx.strokeStyle = st.color;
                ctx.stroke();

                ctx.font = '11px sans-serif';
                ctx.textAlign = 'center';
                ctx.textBaseline = 'middle';
                ctx.fillText(st.symbol, pt.x, pt.y + 0.5);

                if (m.title) {
                    ctx.font = '600 11px "Inter", sans-serif';
                    const tw = ctx.measureText(m.title).width;
                    ctx.fillStyle = 'rgba(6, 10, 19, 0.88)';
                    ctx.strokeStyle = isSel ? '#22d3ee' : 'rgba(56, 189, 248, 0.25)';
                    ctx.lineWidth = 1;
                    ctx.beginPath();
                    ctx.roundRect(pt.x - tw / 2 - 6, pt.y + 13, tw + 12, 18, 5);
                    ctx.fill();
                    ctx.stroke();

                    ctx.fillStyle = '#f8fafc';
                    ctx.textBaseline = 'alphabetic';
                    ctx.fillText(m.title, pt.x, pt.y + 26);
                }
                ctx.restore();
            });
        }

        function drawCompassRose(x, y) {
            ctx.save();
            ctx.translate(x, y);
            ctx.strokeStyle = 'rgba(34, 211, 238, 0.45)';
            ctx.fillStyle = 'rgba(10, 16, 28, 0.8)';
            ctx.lineWidth = 1.2;

            ctx.beginPath();
            ctx.arc(0, 0, 24, 0, Math.PI * 2);
            ctx.fill();
            ctx.stroke();

            ctx.beginPath();
            ctx.moveTo(0, -18);
            ctx.lineTo(5, 0);
            ctx.lineTo(0, -4);
            ctx.lineTo(-5, 0);
            ctx.closePath();
            ctx.fillStyle = '#22d3ee';
            ctx.fill();

            ctx.fillStyle = '#94a3b8';
            ctx.font = 'bold 9px "Orbitron", sans-serif';
            ctx.textAlign = 'center';
            ctx.fillText('N', 0, -27);
            ctx.restore();
        }

