        const offCtx = offscreenCanvas.getContext('2d');

        let heightGrid = new Float32Array(TERRAIN_RES * TERRAIN_RES);
        let noiseGen = new FastNoise2D(state.terrain.seed);

        function octagonDistance(nx, ny) {
            const ax = Math.abs(nx);
            const ay = Math.abs(ny);
            return Math.max(ax, ay, (ax + ay) * 0.70710678);
        }

        function computeElevationAt(nx, ny) {
            const p = state.terrain;
            const scale = (p.islandSize / 82) * 0.85;
            const sx = nx / scale;
            const sy = ny / scale;

            const rCircle = Math.hypot(sx, sy);
            const rOct = octagonDistance(sx, sy);
            const octMix = p.octagonBlend / 100;
            let r = rCircle * (1 - octMix) + rOct * octMix;

            const angle = Math.atan2(sy, sx);
            const bayAngle = Math.abs(angle - 0.85);
            if (bayAngle < 0.55 && r > 0.28) {
                r += (0.55 - bayAngle) * 0.36;
            }

            const rough = p.roughness / 100;
            const warpX = noiseGen.fbm(sx * 2.2 + 5.1, sy * 2.2 + 1.7, 3) * 0.42 * rough;
            const warpY = noiseGen.fbm(sx * 2.2 + 9.3, sy * 2.2 + 4.4, 3) * 0.42 * rough;

            const baseNoise = noiseGen.fbm((sx + warpX) * 2.8 + 10, (sy + warpY) * 2.8 + 10, 5, 0.54, 2.1);
            const detailNoise = noiseGen.fbm(sx * 7.5 + 30, sy * 7.5 + 30, 3, 0.5, 2.0) * 0.16 * rough;

            let falloff = Math.pow(Math.max(0, 1 - Math.pow(r * 0.96, 2.35)), 1.35);
            let h = (baseNoise * 0.78 + detailNoise + 0.18) * falloff;

            if (r < 0.30 && h > 0.35) {
                const flatFactor = (p.centralPlateau / 100) * (1 - r / 0.30);
                h = h * (1 - flatFactor * 0.72) + 0.53 * (flatFactor * 0.72);
            }

            return Math.max(0, Math.min(1, h));
        }

        function rebuildIslandTerrain() {
            noiseGen = new FastNoise2D(state.terrain.seed);
            const SEA_LEVEL = 0.38;

            for (let y = 0; y < TERRAIN_RES; y++) {
                const ny = (y / (TERRAIN_RES - 1)) * 2 - 1;
                for (let x = 0; x < TERRAIN_RES; x++) {
                    const nx = (x / (TERRAIN_RES - 1)) * 2 - 1;
                    heightGrid[y * TERRAIN_RES + x] = computeElevationAt(nx, ny);
                }
            }

            const imgData = offCtx.createImageData(TERRAIN_RES, TERRAIN_RES);
            const data = imgData.data;

            for (let y = 0; y < TERRAIN_RES; y++) {
                const ny = (y / (TERRAIN_RES - 1)) * 2 - 1;
                for (let x = 0; x < TERRAIN_RES; x++) {
                    const nx = (x / (TERRAIN_RES - 1)) * 2 - 1;
                    const idx = y * TERRAIN_RES + x;
                    const h = heightGrid[idx];
                    const pIdx = idx * 4;

                    const hRight = x < TERRAIN_RES - 1 ? heightGrid[idx + 1] : h;
                    const hDown = y < TERRAIN_RES - 1 ? heightGrid[idx + TERRAIN_RES] : h;
                    const shade = ((h - hRight) + (h - hDown)) * 18.0;

                    let r = 6, g = 11, b = 22;

                    if (h < SEA_LEVEL) {
                        const depth = h / SEA_LEVEL;
                        if (state.terrain.showShallows && depth > 0.83) {
                            r = 14 + depth * 18;
                            g = 46 + depth * 32;
                            b = 74 + depth * 40;
                        } else {
                            r = 5 + Math.pow(depth, 2) * 10;
                            g = 10 + Math.pow(depth, 2) * 24;
                            b = 20 + Math.pow(depth, 2) * 38;
                        }
                    } else {
                        const landH = (h - SEA_LEVEL) / (1 - SEA_LEVEL);
                        const microTex = (noiseGen.noise(nx * 36, ny * 36) - 0.5) * 14;

                        if (state.terrain.useBiomeDesign) {
                            const pal = getBlendedBiomePalette(nx, ny);
                            let baseCol;
                            if (landH < 0.25) {
                                const t = landH / 0.25;
                                baseCol = pal.low.map((v, i) => v + (pal.mid[i] - v) * t);
                            } else if (landH < 0.62) {
                                const t = (landH - 0.25) / 0.37;
                                baseCol = pal.mid.map((v, i) => v + (pal.high[i] - v) * t);
                            } else {
                                const t = Math.min(1, (landH - 0.62) / 0.38);
                                baseCol = pal.high.map((v, i) => v + (pal.peak[i] - v) * t);
                            }
                            r = baseCol[0] + shade * 38 + microTex;
                            g = baseCol[1] + shade * 38 + microTex;
                            b = baseCol[2] + shade * 38 + microTex;
                        } else {
                            if (landH < 0.09) {
                                r = 74 + landH * 120;
                                g = 88 + landH * 140;
                                b = 68 + landH * 80;
                            } else if (landH < 0.45) {
                                r = 42 + landH * 55;
                                g = 78 + landH * 65;
                                b = 52 + landH * 40;
                            } else {
                                r = 82 + landH * 90;
                                g = 88 + landH * 85;
                                b = 92 + landH * 90;
                            }
                            r += shade * 36 + microTex;
                            g += shade * 36 + microTex;
                            b += shade * 36 + microTex;
                        }

                        if (state.terrain.contourOpacity > 0) {
                            const contourStep = (landH * 12) % 1;
                            if (contourStep < 0.065) {
                                const cOp = (state.terrain.contourOpacity / 100) * 0.65;
                                r = r * (1 - cOp) + 220 * cOp;
                                g = g * (1 - cOp) + 245 * cOp;
                                b = b * (1 - cOp) + 255 * cOp;
                            }
                        }

                        if (landH < 0.028) {
                            r = 34; g = 185; b = 215;
                        }
                    }

                    data[pIdx]     = Math.max(0, Math.min(255, r));
                    data[pIdx + 1] = Math.max(0, Math.min(255, g));
                    data[pIdx + 2] = Math.max(0, Math.min(255, b));
                    data[pIdx + 3] = 255;
                }
            }

            offCtx.putImageData(imgData, 0, 0);
            renderMap();
        }

        /***********************************************************************
         * 7. MAIN INTERACTIVE CANVAS RENDERING
         ***********************************************************************/
        const canvas = document.getElementById('map-canvas');
        const ctx = canvas.getContext('2d');

        function getMapDrawMetrics() {
            const w = canvas.width;
            const h = canvas.height;
            const baseSize = Math.min(w, h) * 0.86 * state.view.zoom;
            const cx = w / 2 + state.view.panX;
            const cy = h / 2 + state.view.panY;
            return { w, h, baseSize, cx, cy };
        }

        function worldToScreen(wx, wy) {
            const { baseSize, cx, cy } = getMapDrawMetrics();
            return {
                x: cx + wx * (baseSize / 2),
                y: cy + wy * (baseSize / 2)
            };
        }

        function screenToWorld(sx, sy) {
            const { baseSize, cx, cy } = getMapDrawMetrics();
            return {
                x: (sx - cx) / (baseSize / 2),
                y: (sy - cy) / (baseSize / 2)
            };
        }

        function renderMap() {
            const { w, h, baseSize, cx, cy } = getMapDrawMetrics();
            ctx.clearRect(0, 0, w, h);

            const bgGrad = ctx.createRadialGradient(cx, cy, baseSize * 0.08, cx, cy, Math.max(w, h) * 0.9);
            bgGrad.addColorStop(0, '#091426');
            bgGrad.addColorStop(1, '#04070e');
            ctx.fillStyle = bgGrad;
            ctx.fillRect(0, 0, w, h);

            ctx.save();
            ctx.imageSmoothingEnabled = true;
            ctx.drawImage(offscreenCanvas, cx - baseSize / 2, cy - baseSize / 2, baseSize, baseSize);
            ctx.restore();

            drawArchitecturalRuins(cx, cy, baseSize);
            drawFogOfWarLockedSectors(cx, cy, baseSize);

            if (state.focusedSectorId !== null) {
                drawFocusedSectorSpotlight(cx, cy, baseSize, state.focusedSectorId);
            }

            if (state.overlays.showSectors) {
                drawNineBiomesOverlay(cx, cy, baseSize);
            }

            if (state.overlays.showBarrier) {
                drawBarrierOverlay(cx, cy, baseSize);
            }

            drawMarkers(cx, cy, baseSize);

            if (state.overlays.showCompass) {
                drawCompassRose(w - 58, h - 68);
            }
        }

        function buildSectorClipPath(ctx, cx, cy, baseSize, sectorId) {
            const innerR = (baseSize / 2) * 0.25;
            const outerR = (baseSize / 2) * 0.97;
            ctx.beginPath();
            if (sectorId === 0) {
                ctx.arc(cx, cy, innerR, 0, Math.PI * 2);
            } else {
                const { startAngle, endAngle } = getSectorAngles(sectorId);
                ctx.arc(cx, cy, outerR, startAngle, endAngle, false);
                ctx.arc(cx, cy, innerR, endAngle, startAngle, true);
                ctx.closePath();
            }
        }

        function drawFogOfWarLockedSectors(cx, cy, baseSize) {
            for (let sId = 0; sId <= 8; sId++) {
                if (state.unlockedSectors[sId]) continue;

                ctx.save();
                buildSectorClipPath(ctx, cx, cy, baseSize, sId);
                ctx.clip();

                ctx.fillStyle = '#050913';
                ctx.fillRect(cx - baseSize, cy - baseSize, baseSize * 2, baseSize * 2);

                ctx.strokeStyle = 'rgba(34, 211, 238, 0.08)';
                ctx.lineWidth = 1;
                const step = Math.max(14, baseSize * 0.025);
                for (let d = -baseSize; d <= baseSize; d += step) {
                    ctx.beginPath();
                    ctx.moveTo(cx + d - baseSize * 0.5, cy - baseSize * 0.5);
                    ctx.lineTo(cx + d + baseSize * 0.5, cy + baseSize * 0.5);
                    ctx.stroke();
                }

                ctx.restore();

                const centerWorld = getSectorWorldCenter(sId);
                const pt = worldToScreen(centerWorld.x, centerWorld.y);
                ctx.save();
                ctx.fillStyle = 'rgba(10, 18, 34, 0.92)';
                ctx.strokeStyle = 'rgba(148, 163, 184, 0.35)';
                ctx.lineWidth = 1;
                const boxW = sId === 0 ? 115 : 130;
                const boxH = 38;
                ctx.beginPath();
                ctx.roundRect(pt.x - boxW / 2, pt.y - boxH / 2, boxW, boxH, 8);
                ctx.fill();
                ctx.stroke();

                ctx.fillStyle = '#94a3b8';
                ctx.font = 'bold 10px "JetBrains Mono", monospace';
                ctx.textAlign = 'center';
                ctx.fillText(`🔒 ${ARK_BIOMES[sId].code}`, pt.x, pt.y - 3);
                ctx.fillStyle = '#64748b';
                ctx.font = '9px "Inter", sans-serif';
                ctx.fillText('НЕ ДОСЛІДЖЕНО', pt.x, pt.y + 11);
                ctx.restore();
            }
        }

        function drawFocusedSectorSpotlight(cx, cy, baseSize, focusedId) {
            for (let sId = 0; sId <= 8; sId++) {
                if (sId === focusedId) continue;
                ctx.save();
                buildSectorClipPath(ctx, cx, cy, baseSize, sId);
                ctx.fillStyle = 'rgba(3, 6, 14, 0.76)';
                ctx.fill();
                ctx.restore();
            }

            ctx.save();
            buildSectorClipPath(ctx, cx, cy, baseSize, focusedId);
            ctx.strokeStyle = ARK_BIOMES[focusedId].accent;
            ctx.lineWidth = 2.8;
            ctx.shadowColor = ARK_BIOMES[focusedId].accent;
            ctx.shadowBlur = 16;
            ctx.stroke();
            ctx.restore();
        }

        function drawArchitecturalRuins(cx, cy, baseSize) {
            const clusters = state.details.ruinClusters;
            if (!clusters || clusters.length === 0) return;

            const wallColor = '#99f6e4';
            const wallFill = 'rgba(15, 36, 48, 0.88)';
            const roofColor = 'rgba(34, 211, 238, 0.30)';
            const rubbleColor = 'rgba(94, 234, 212, 0.58)';
            const roadColor = 'rgba(34, 211, 238, 0.16)';

            clusters.forEach(cluster => {
                const secId = getSectorIdAtPoint(cluster.x, cluster.y);
                if (!state.unlockedSectors[secId]) return;

                const center = worldToScreen(cluster.x, cluster.y);
                const radiusPx = cluster.radiusWorld * (cluster.scaleMultiplier || 1.0) * (baseSize / 2);
                if (radiusPx < 2.5) return;

                const isSelected = state.editor.selectedItem?.type === 'ruin' && state.editor.selectedItem?.id === cluster.id;

                ctx.save();
                ctx.translate(center.x, center.y);
                ctx.rotate(cluster.rotation);

                const scorchGrad = ctx.createRadialGradient(0, 0, radiusPx * 0.1, 0, 0, radiusPx * 1.15);
                scorchGrad.addColorStop(0, 'rgba(8, 12, 20, 0.58)');
                scorchGrad.addColorStop(0.7, 'rgba(8, 12, 20, 0.25)');
                scorchGrad.addColorStop(1, 'rgba(8, 12, 20, 0)');
                ctx.fillStyle = scorchGrad;
                ctx.beginPath();
                ctx.arc(0, 0, radiusPx * 1.15, 0, Math.PI * 2);
                ctx.fill();

                if (radiusPx > 8 && cluster.roads) {
                    ctx.strokeStyle = roadColor;
                    ctx.lineCap = 'butt';
                    cluster.roads.forEach(rd => {
                        ctx.lineWidth = Math.max(1.2, rd.width * radiusPx);
                        ctx.beginPath();
                        ctx.moveTo(rd.x1 * radiusPx, rd.y1 * radiusPx);
                        ctx.lineTo(rd.x2 * radiusPx, rd.y2 * radiusPx);
                        ctx.stroke();
                    });
                }

                if (cluster.craters) {
                    cluster.craters.forEach(cr => {
                        const crx = cr.x * radiusPx;
                        const cry = cr.y * radiusPx;
                        const crr = Math.max(1.5, cr.r * radiusPx);
                        ctx.fillStyle = 'rgba(4, 7, 13, 0.75)';
                        ctx.beginPath();
                        ctx.arc(crx, cry, crr, 0, Math.PI * 2);
                        ctx.fill();
                        ctx.strokeStyle = 'rgba(148, 163, 184, 0.28)';
                        ctx.lineWidth = Math.max(0.7, radiusPx * 0.02);
                        ctx.stroke();
                    });
                }

                if (state.ruinConfig.showRubble && radiusPx > 6 && cluster.rubbleChunks) {
                    cluster.rubbleChunks.forEach(rb => {
                        ctx.save();
                        ctx.translate(rb.x * radiusPx, rb.y * radiusPx);
                        ctx.rotate(rb.rot);
                        ctx.fillStyle = rb.dark ? 'rgba(15, 23, 42, 0.85)' : rubbleColor;
                        const rw = Math.max(1.2, rb.w * radiusPx);
                        const rh = Math.max(1.2, rb.h * radiusPx);
                        ctx.fillRect(-rw / 2, -rh / 2, rw, rh);
                        ctx.restore();
                    });
                }

                cluster.buildings.forEach(b => {
                    const bx = b.x * radiusPx;
                    const by = b.y * radiusPx;
                    const bw = Math.max(3, b.w * radiusPx);
                    const bh = Math.max(3, b.h * radiusPx);

                    ctx.save();
                    ctx.translate(bx, by);
                    ctx.rotate(b.rot);

                    const shadowOff = Math.max(1.5, radiusPx * 0.045);
                    ctx.fillStyle = 'rgba(2, 5, 11, 0.78)';
                    if (b.shape === 'silo_circle' || b.shape === 'octagon_dome') {
                        ctx.beginPath();
                        ctx.arc(shadowOff, shadowOff, bw * 0.48, 0, Math.PI * 2);
                        ctx.fill();
                    } else {
                        ctx.fillRect(-bw / 2 + shadowOff, -bh / 2 + shadowOff, bw, bh);
                    }

                    ctx.fillStyle = wallFill;
                    if (b.shape === 'silo_circle') {
                        ctx.beginPath();
                        ctx.arc(0, 0, bw * 0.48, 0, Math.PI * 2);
                        ctx.fill();
                    } else if (b.shape === 'octagon_dome') {
                        const r = bw * 0.5;
                        ctx.beginPath();
                        for (let i = 0; i < 8; i++) {
                            const a = (i / 8) * Math.PI * 2 + Math.PI / 8;
                            const px = Math.cos(a) * r;
                            const py = Math.sin(a) * r;
                            if (i === 0) ctx.moveTo(px, py);
                            else ctx.lineTo(px, py);
                        }
                        ctx.closePath();
                        ctx.fill();
                    } else if (b.shape === 'l_shape') {
                        ctx.beginPath();
                        ctx.moveTo(-bw / 2, -bh / 2);
                        ctx.lineTo(bw / 2, -bh / 2);
                        ctx.lineTo(bw / 2, 0);
                        ctx.lineTo(0, 0);
                        ctx.lineTo(0, bh / 2);
                        ctx.lineTo(-bw / 2, bh / 2);
                        ctx.closePath();
                        ctx.fill();
                    } else {
                        ctx.fillRect(-bw / 2, -bh / 2, bw, bh);
                    }

                    if (b.hasInnerRooms && radiusPx > 12 && b.shape === 'rect') {
                        ctx.strokeStyle = 'rgba(148, 163, 184, 0.35)';
                        ctx.lineWidth = Math.max(0.6, radiusPx * 0.018);
                        ctx.beginPath();
                        ctx.moveTo(0, -bh / 2);
                        ctx.lineTo(0, bh * 0.2);
                        ctx.moveTo(-bw / 2, 0);
                        ctx.lineTo(bw * 0.3, 0);
                        ctx.stroke();
                    }

                    ctx.fillStyle = roofColor;
                    if (b.shape === 'silo_circle' || b.shape === 'octagon_dome') {
                        ctx.beginPath();
                        ctx.arc(0, 0, bw * 0.46, 0, Math.PI * 2 * b.roofIntactRatio);
                        ctx.lineTo(0, 0);
                        ctx.closePath();
                        ctx.fill();
                    } else {
                        const rw = bw * Math.min(1, b.roofIntactRatio * 1.25);
                        ctx.fillRect(-bw / 2, -bh / 2, rw, bh * 0.85);
                    }

                    ctx.strokeStyle = wallColor;
                    ctx.lineWidth = Math.max(1.1, radiusPx * 0.038);
                    ctx.lineCap = 'square';

                    if (b.shape === 'silo_circle' || b.shape === 'octagon_dome') {
                        const r = bw * 0.48;
                        for (let s = 0; s < 8; s++) {
                            if (!b.wallSegments[s]) continue;
                            const a1 = (s / 8) * Math.PI * 2;
                            const a2 = ((s + 0.82) / 8) * Math.PI * 2;
                            ctx.beginPath();
                            ctx.arc(0, 0, r, a1, a2);
                            ctx.stroke();
                        }
                    } else {
                        const corners = [
                            { x: -bw / 2, y: -bh / 2 },
                            { x:  bw / 2, y: -bh / 2 },
                            { x:  bw / 2, y:  bh / 2 },
                            { x: -bw / 2, y:  bh / 2 }
                        ];
                        for (let side = 0; side < 4; side++) {
                            const c1 = corners[side];
                            const c2 = corners[(side + 1) % 4];
                            const mx = (c1.x + c2.x) / 2;
                            const my = (c1.y + c2.y) / 2;

                            if (b.wallSegments[side * 2]) {
                                ctx.beginPath();
                                ctx.moveTo(c1.x, c1.y);
                                ctx.lineTo(mx, my);
                                ctx.stroke();
                            }
                            if (b.wallSegments[side * 2 + 1]) {
                                ctx.beginPath();
                                ctx.moveTo(mx, my);
                                ctx.lineTo(c2.x, c2.y);
                                ctx.stroke();
                            }
                        }
                    }

                    ctx.restore();
                });

                ctx.restore();

                if (isSelected) {
                    ctx.save();
                    ctx.strokeStyle = '#22d3ee';
                    ctx.lineWidth = 2;
                    ctx.setLineDash([5, 4]);
                    ctx.beginPath();
                    ctx.arc(center.x, center.y, radiusPx * 1.08, 0, Math.PI * 2);
                    ctx.stroke();
                    ctx.restore();
                }

                if (state.ruinConfig.showLabels && (state.view.zoom >= 1.25 || isSelected || state.focusedSectorId !== null)) {
                    ctx.save();
                    ctx.font = '600 10px "Inter", sans-serif';
                    const textW = ctx.measureText(cluster.title).width;
                    ctx.fillStyle = 'rgba(6, 10, 18, 0.84)';
                    ctx.strokeStyle = isSelected ? '#22d3ee' : 'rgba(148, 163, 184, 0.35)';
                    ctx.lineWidth = 1;
                    ctx.beginPath();
                    ctx.roundRect(center.x - textW / 2 - 5, center.y + radiusPx + 4, textW + 10, 16, 4);
                    ctx.fill();
                    ctx.stroke();

                    ctx.fillStyle = isSelected ? '#67e8f9' : '#cbd5e1';
                    ctx.textAlign = 'center';
                    ctx.fillText(cluster.title, center.x, center.y + radiusPx + 15);
                    ctx.restore();
                }
            });
        }

        function drawNineBiomesOverlay(cx, cy, baseSize) {
            ctx.save();
            const outerR = (baseSize / 2) * 0.90;
            const innerR = (baseSize / 2) * 0.25;

            ctx.strokeStyle = 'rgba(34, 211, 238, 0.55)';
            ctx.lineWidth = 1.6;
            ctx.setLineDash([6, 4]);
            ctx.beginPath();
            ctx.arc(cx, cy, innerR, 0, Math.PI * 2);
            ctx.stroke();

            ctx.strokeStyle = 'rgba(56, 189, 248, 0.35)';
            ctx.lineWidth = 1.3;
            for (let i = 0; i < 8; i++) {
                const angle = (i * Math.PI) / 4 - Math.PI / 8;
                ctx.beginPath();
                ctx.moveTo(cx + Math.cos(angle) * innerR, cy + Math.sin(angle) * innerR);
                ctx.lineTo(cx + Math.cos(angle) * outerR, cy + Math.sin(angle) * outerR);
                ctx.stroke();
            }
            ctx.setLineDash([]);

            if (state.overlays.showSectorLabels) {
                for (let sId = 1; sId <= 8; sId++) {
                    if (!state.unlockedSectors[sId]) continue;
                    const { midAngle } = getSectorAngles(sId);
                    const labelR = (innerR + outerR) * 0.56;
                    const lx = cx + Math.cos(midAngle) * labelR;
                    const ly = cy + Math.sin(midAngle) * labelR;

                    const biome = ARK_BIOMES[sId];
                    ctx.font = 'bold 10px "Orbitron", sans-serif';
                    ctx.textAlign = 'center';
                    ctx.fillStyle = 'rgba(6, 10, 20, 0.78)';
                    const tw = Math.max(ctx.measureText(biome.code).width, ctx.measureText(biome.name).width * 0.85) + 14;
                    ctx.beginPath();
                    ctx.roundRect(lx - tw / 2, ly - 15, tw, 28, 6);
                    ctx.fill();

                    ctx.fillStyle = biome.accent;
                    ctx.fillText(biome.code, lx, ly - 3);
                    ctx.font = '600 9px "Inter", sans-serif';
                    ctx.fillStyle = '#e2e8f0';
                    ctx.fillText(biome.name, lx, ly + 9);
                }
            }

            ctx.restore();
        }

        function drawBarrierOverlay(cx, cy, baseSize) {
            ctx.save();
            const barrierR = (baseSize / 2) * 0.94;

            ctx.strokeStyle = 'rgba(34, 211, 238, 0.55)';
            ctx.lineWidth = 2;
            ctx.setLineDash([12, 6, 3, 6]);
            ctx.beginPath();
            ctx.arc(cx, cy, barrierR, 0, Math.PI * 2);
            ctx.stroke();
            ctx.setLineDash([]);

            if (state.overlays.showCorruptionRing) {
                const grad = ctx.createRadialGradient(cx, cy, barrierR * 0.93, cx, cy, barrierR * 1.07);
                grad.addColorStop(0, 'rgba(244, 63, 94, 0)');
                grad.addColorStop(0.5, 'rgba(244, 63, 94, 0.20)');
                grad.addColorStop(1, 'rgba(244, 63, 94, 0)');
                ctx.fillStyle = grad;
                ctx.beginPath();
                ctx.arc(cx, cy, barrierR * 1.07, 0, Math.PI * 2);
                ctx.fill();
            }
            ctx.restore();
        }

        const MARKER_STYLES = {
            ciel:       { color: '#22d3ee', bg: '#083344', symbol: '💠', badge: 'ЯДРО СІЕЛЬ' },
            beacon:     { color: '#f59e0b', bg: '#451a03', symbol: '🗼', badge: 'МАЯК АРХАНГЕЛА' },
            metro:      { color: '#38bdf8', bg: '#0c4a6e', symbol: '🚇', badge: 'ВАГОН МЕТРО (ХАБ)' },
            ruins:      { color: '#a855f7', bg: '#3b0764', symbol: '🏛️', badge: 'БУНКЕР ВАВИЛОНІЇ' },
            corruption: { color: '#f43f5e', bg: '#4c0519', symbol: '☣️', badge: 'ПРОРИВ СКВЕРНИ' },
            camp:       { color: '#10b981', bg: '#064e3b', symbol: '⛺', badge: 'ТАБІР / БАЗА' },
